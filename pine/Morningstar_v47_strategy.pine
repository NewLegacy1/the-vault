//@version=6
// Morningstar v47 STRATEGY — BUILD v33 (2026-07-24)
// Dual46 freeze stays on Morningstar_v46.pine
// Tag MUST say "v33".
//
// v15-parity Tester + readable chart:
//   Dual46 RB · Limit · Both · Fixed 1:5 / floor 80 / cap 100 · OTE live · spent 1L+1P
//   Leave KO gate A/B: Pad ±N (Jul harvest used 50) vs KO-in-RB-zone (Powell). Multi-month.
strategy(
     title                   = "Morningstar v47 Strategy (Dual47) v33",
     shorttitle              = "MSv47 v33",
     overlay                 = true,
     max_bars_back           = 5000,
     max_lines_count         = 500,
     max_boxes_count         = 500,
     max_labels_count        = 500,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     calc_on_order_fills     = true,
     pyramiding              = 0,
     initial_capital         = 50000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 10,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.62,
     slippage                = 0,
     margin_long             = 0,
     margin_short            = 0,
     currency                = currency.USD)

// ─── Inputs (ALL input.* contiguous) — Stage-0 A/B ONLY ───
grpAb = "A/B (flip these)"
i_simLeave  = input.bool(true, "Leave sleeve (arm + Tester)", group = grpAb, tooltip = "DEFAULT ON after Jul v13 harvest (+$2.7k leave+powell). Still SHADOW — confirm on May/June before Lab language.")
i_simPowell = input.bool(true, "Powell sleeve (arm + Tester)", group = grpAb, tooltip = "OFF = no Powell arms / Tester trades.")
i_fillMode  = input.string("Limit @ wick", "Entry fill", options = ["Limit @ wick", "Auto (mkt if close through)", "Market"], group = grpAb, tooltip = "DEFAULT Limit — rest entry until retest (matches Dual46 live). Auto = MKT only if arm-bar CLOSE is already through entry (chase).")
i_powellRbTf = input.string("1m only", "LIVE RB timeframe", options = ["1m only", "5m only", "1m or 5m"], group = grpAb, tooltip = "DEFAULT 1m only (Dual46-like).")
i_approachPts = input.float(15.0, "Approaching band (pts)", minval = 2.0, step = 1.0, group = grpAb, tooltip = "Within this many pts of entry and moving toward it → FILL→ LMT (coming). Ripping away → FILL→ AWAY (don't chase).")
i_leaveKoGate = input.string("Pad ±N", "Leave KO gate", options = ["Pad ±N", "KO in RB zone"], group = grpAb, tooltip = "A/B over months. Pad ±N = Jul harvest style (loose = more leave fills / higher Jul P&L). KO in RB zone = same strict gate as Powell (±powellKoTol).")
i_leaveKoPad = input.float(50.0, "Leave KO pad (pts)", minval = 2.0, maxval = 100.0, step = 1.0, group = grpAb, tooltip = "Only when Leave KO gate = Pad ±N. Jul baseline 50. Try 15 / 25 for tighter. Unused in KO-in-zone mode.")
i_leaveCancelAway = input.bool(false, "Leave: cancel unfilled if price runs away", group = grpAb, tooltip = "OFF default — Jul hurt P&L (~$5k→$3.8k). Prefer KO-gate A/B over this.")
i_leaveCancelAwayPts = input.float(60.0, "Leave: cancel after run (pts)", minval = 20.0, maxval = 150.0, step = 5.0, group = grpAb, tooltip = "Long leave: cancel if high ≥ entry + N. Short leave: cancel if low ≤ entry − N. Default 60.")

grpUi = "Chart"
i_showChart = input.bool(true, "Show plan lines (entry/stop/TP)", group = grpUi)
i_showKeyOpens = input.bool(true, "Show key opens (18:00 · mid · 10:00)", group = grpUi)
i_showSig = input.bool(true, "Show rejection block boxes", group = grpUi, tooltip = "Semi-transparent box on the RB wick zone for leave / Powell arms.")
i_showPlanDetail = input.bool(true, "Show WIN/LOSS + fill status on plan", group = grpUi)
i_showRrBoxes = input.bool(false, "Show risk / reward boxes", group = grpUi, tooltip = "OFF default — plan lines are enough.")
i_rbBoxTransp = input.int(88, "RB box fill transparency", minval = 50, maxval = 97, group = grpUi)
i_keyOpenHistDays = input.int(10, "Key-open history (days)", minval = 1, maxval = 60, group = grpUi)
i_simDebug = input.bool(false, "Yellow debug tag + fire triangles", group = grpUi)

grpCol = "Colors"
c_bear = input.color(#ef4444, "Bearish", group = grpCol)
c_bull = input.color(#7dd3fc, "Bullish", group = grpCol)
c_ce = input.color(#e2e8f0, "CE", group = grpCol)
c_limit = input.color(#f8fafc, "ENTRY", group = grpCol)
c_stop = input.color(#f87171, "STOP", group = grpCol)
c_tp = input.color(#34d399, "TP", group = grpCol)
c_pdh = input.color(#22c55e, "PDH", group = grpCol)
c_pdl = input.color(#ef4444, "PDL", group = grpCol)
c_win10 = input.color(#eab308, "10:00 wash", group = grpCol)
c_ko = input.color(#fbbf24, "10:00 KO line", group = grpCol)
c_midn = input.color(#f472b6, "Midnight open", group = grpCol)
c_1800 = input.color(#4ade80, "18:00 open", group = grpCol)
c_rbLeave = input.color(#f59e0b, "Leave RB box", group = grpCol)
c_rbLong = input.color(#7dd3fc, "Powell long RB box", group = grpCol)
c_rbShort = input.color(#ef4444, "Powell short RB box", group = grpCol)
c_lblWin = input.color(#34d399, "WIN label", group = grpCol)
c_lblLoss = input.color(#f87171, "LOSS label", group = grpCol)
c_lblLive = input.color(#f8fafc, "Live / pending label", group = grpCol)

// ─── LOCKED Dual47 defaults (edit here — not in TV UI) ───
// Prop book: $50k · 10 MNQ. P&L in Tester ≈ 10× the 1-lot CSVs. Change only in this file.
i_simQty = 10
i_winEnd      = 1300
i_flatTime    = 1555
i_oneTradeDay = false
// Hard stop on Tester spam (v24: 77× Judas KO on Jul 20). Booleans beat counters.
i_maxLeaveFillsDay = 1
i_maxPowellFillsDay = 1
i_skipMonday  = false
i_skipJulOct  = false
i_biasMode    = "Long & Short"
i_biasShowAuto = false

i_pathB = true
// Sleeve string kept for legacy singleSlotLock checks; real gates are i_simLeave / i_simPowell.
i_pathBSleeve = i_simLeave and i_simPowell ? "KO-leave + KO-retest" : i_simLeave ? "KO-leave only" : "KO-retest only"
i_pathBAlign = 50.0
i_powellKoTol = 3.0
i_powellWaitDeepKo = true
i_leaveWinMin = 45
i_pathBAwayPts = 25.0
i_retestMinRisk = 10.0
i_leaveMinRisk = 6.0
i_leavePrefer5 = true
i_powellRequireOte = true
i_powellRequireKoStack = false
i_powellShowEyes = false
i_powellAllowDeepKo = false
i_koScan = false
i_koScanPad = 12.0
i_koStack = false
i_koStackMin = 3
i_koStackMinRisk = 6.0
i_koStackNeedStruct = true
i_powellGeom = "1m RB wick"
// Both = v15 baseline (Jul 9 Judas·OTE was a real winner). KO-only blocked by OTE gate + spent.
i_powellModel = "Both"
i_powellNeedRb = true
i_powellShowOte = true
i_powellFibMinLeg = 200.0
i_powellFibMinRisk = 18.0
i_fibFreezePull = 25.0
i_fibFreezeMinMin = 15
i_fibMinLegPts = 80.0
i_fibScanStart = 830
i_fibLegLookback = 120
i_fibUseOpen = true
i_fibManipMaxDist = 220.0
i_showDil = false
i_dilBounce = 15.0
i_dilPivot = 2
i_retestMinAfterLeave = 15
i_minWick1 = 4.0
i_minWick5 = 6.0
i_rbSweepWick = true
i_showRbMarks = false
i_pathBShowFib = false
i_pathBShowState = false

i_showNwog = false
i_nwogMinPts = 5.0
i_showPdhPdl = false
i_showPend = i_showChart
i_rbNoFill = true

i_maxStopPts = 40.0
i_minStopPts = 3.0
i_stopBufPts = 2.0
// TP: Fixed 1:5, cap 100, min floor 80 (v15 Tester parity). Live Dual46 is pure 1:5 — A/B later.
i_rr = 5.0
i_powellTp = "Fixed R"
i_powellMinTpR = 3.0
i_powellMaxTpR = 5.0
i_powellMaxTpPts = 100.0
// Dual46 live = pure 1:5 (no floor). v15 Tester baseline used max(5R, 80) —
// four of five July winners were exactly +80 pts. Restore floor for v15-parity.
i_minTpPts = 80.0
i_originMinPull = 40.0
i_intPivot = 3

i_simOrders = true
i_simKoLtf = false
i_simFlatClose = true
i_simPriority = "First LIVE wins"
i_smoke = false

// Derived flags (after ALL inputs + locks)
bool wantLeave = i_simLeave
bool wantRetest = i_simPowell
bool wantCont = i_powellModel == "Continuation" or i_powellModel == "Both"
bool wantJudas = i_powellModel == "Judas reverse" or i_powellModel == "Both"
bool autoBiasOn = i_biasMode == "Auto PDH/PDL draw"
bool allow1mRb = i_powellRbTf == "1m only" or i_powellRbTf == "1m or 5m"
bool allow5mRb = i_powellRbTf == "5m only" or i_powellRbTf == "1m or 5m"

// ─── Time ────────────────────────────────────────────────────────────────────
int nyHhmm = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
int nyMonth = month(time, "America/New_York")
int nyDow = dayofweek(time, "America/New_York")
int nyYmd = year(time, "America/New_York") * 10000 + nyMonth * 100 + dayofmonth(time, "America/New_York")
// CME daily bars roll ~18:00 ET — do NOT wipe Path B / plans on that. Calendar midnight only.
bool newCalDay = ta.change(nyYmd) != 0
// Session day (exchange "D") — PDH/PDL / day high-low only
bool newSessDay = ta.change(time("D", "America/New_York")) != 0
bool canPlace = nyHhmm < i_winEnd
bool mondayOk = not i_skipMonday or nyDow != dayofweek.monday
bool monthOk = not i_skipJulOct or (nyMonth != 7 and nyMonth != 10)
bool dayAllowed = mondayOk and monthOk

// Lookback bars for origin (minutes → chart bars)
float _tfMin = math.max(1.0, timeframe.in_seconds() / 60.0)
int fibLbBars = math.max(5, int(math.round(i_fibLegLookback / _tfMin)))
float lookHi = ta.highest(high, fibLbBars)
float lookLo = ta.lowest(low, fibLbBars)

// ─── Levels ──────────────────────────────────────────────────────────────────
// Prior day HI/LO — [1] on daily is the last completed day; no lookahead needed.
float prevDayHigh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
float prevDayLow = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)

// Auto PDH/PDL draw (SOP §3) — always computed so eyes can A/B vs manual
var int dayDraw = 0
if newCalDay
    dayDraw := 0
if not na(prevDayHigh) and high > prevDayHigh and close < prevDayHigh
    dayDraw := -1
if not na(prevDayLow) and low < prevDayLow and close > prevDayLow
    dayDraw := 1

bool biasOkShort = i_biasMode != "Long only" and (not autoBiasOn or dayDraw <= 0)
bool biasOkLong = i_biasMode != "Short only" and (not autoBiasOn or dayDraw >= 0)

var float curDayHigh = na
var float curDayLow = na
var int curDayHighBar = na
var int curDayLowBar = na
var float pdhLvl = na
var float pdlLvl = na
var int pdhOriginBar = na
var int pdlOriginBar = na
var float ko1000 = na
var float openMidnight = na
var float open1800 = na
var int openMidnightBar = na
var int open1800Bar = na
var int ko1000Bar = na
var float nwogFriClose = na
var int nwogGapTime = na
var float nwogTop = na
var float nwogBot = na

if newSessDay
    pdhLvl := curDayHigh
    pdlLvl := curDayLow
    pdhOriginBar := curDayHighBar
    pdlOriginBar := curDayLowBar
    curDayHigh := high
    curDayLow := low
    curDayHighBar := bar_index
    curDayLowBar := bar_index
else
    if na(curDayHigh) or high >= curDayHigh
        curDayHigh := high
        curDayHighBar := bar_index
    if na(curDayLow) or low <= curDayLow
        curDayLow := low
        curDayLowBar := bar_index

// Key opens — calendar NY (10:00 / midnight wipe at calendar day; 18:00 persists into next RTH)
if newCalDay
    ko1000 := na
    ko1000Bar := na
    openMidnight := open
    openMidnightBar := bar_index
bool open1800Print = nyHhmm >= 1800 and nyHhmm[1] < 1800
if open1800Print
    open1800 := open
    open1800Bar := bar_index
bool ko1000Print = nyHhmm >= 1000 and nyHhmm[1] < 1000
bool ko1000Fallback = nyHhmm >= 1000 and na(ko1000)
if ko1000Print or ko1000Fallback
    ko1000 := open
    ko1000Bar := bar_index

bool isFri = nyDow == dayofweek.friday
bool isSun = nyDow == dayofweek.sunday
bool isMon = nyDow == dayofweek.monday
if isFri
    nwogFriClose := close
bool nwogSunOpenBar = isSun and nyHhmm >= 1800 and nyHhmm[1] < 1800
bool nwogMonFallback = isMon and nyHhmm >= 930 and nyHhmm[1] < 930

// ─── RB packs (Dual29 / Dual46 two-candle Powell spec) ───────────────────────
// Dual46 indexing (v27 rollback): A=bar[2], B=bar[1] — matches Morningstar_v46.
// v26 B-close pack picked wrong Cont RB on Jul 23 (28704). Do not re-open that.
// ENTRY = A body/lower-wick junction = min(openA, closeA)
// STOP  = B low (sweep extreme) − buffer
// BEAR RB (short): mirror — ENTRY = A body/upper-wick junction = max(openA, closeA)
// A lone long-wick candle is NEVER an RB.
f_pb1Pack(float minW) =>
    float oA = open[2]
    float cA = close[2]
    float lA = low[2]
    float hA = high[2]
    float oB = open[1]
    float hB = high[1]
    float lB = low[1]
    float cB = close[1]
    // Candle A body ↔ wick junction (NOT midpoint, NOT candle B body)
    float bullWs = math.min(oA, cA)
    float bearWs = math.max(oA, cA)
    bool sweepLoOk = not i_rbSweepWick or lB < lA
    bool sweepHiOk = not i_rbSweepWick or hB > hA
    bool bull = cA < oA and cB > oB and sweepLoOk and lB < bullWs and (bullWs - lB) >= minW
    bool bear = cA > oA and cB < oB and sweepHiOk and hB > bearWs and (hB - bearWs) >= minW
    [bear, bull, hB, lB, bearWs, bullWs]

[b1s, u1s, h1s, l1s, wsB1s, wsU1s] = request.security(syminfo.tickerid, "1", f_pb1Pack(i_minWick1), barmerge.gaps_off, barmerge.lookahead_off)
[b5s, u5s, h5s, l5s, wsB5s, wsU5s] = request.security(syminfo.tickerid, "5", f_pb1Pack(i_minWick5), barmerge.gaps_off, barmerge.lookahead_off)
int t1sec = request.security(syminfo.tickerid, "1", time, barmerge.gaps_off, barmerge.lookahead_off)
int t5sec = request.security(syminfo.tickerid, "5", time, barmerge.gaps_off, barmerge.lookahead_off)
bool new1Bar = ta.change(t1sec) != 0
bool new5Bar = ta.change(t5sec) != 0

bool on1m = timeframe.period == "1"
bool on5m = timeframe.period == "5"
[b1c, u1c, h1c, l1c, wsB1c, wsU1c] = f_pb1Pack(i_minWick1)
bool b1 = on1m ? b1c : b1s
bool u1 = on1m ? u1c : u1s
float h1 = on1m ? h1c : h1s
float l1 = on1m ? l1c : l1s
float wsB1 = on1m ? wsB1c : wsB1s
float wsU1 = on1m ? wsU1c : wsU1s
// B = bar[1] → RB clock is that bar's time
int t1Closed = request.security(syminfo.tickerid, "1", time[1], barmerge.gaps_off, barmerge.lookahead_off)
int t5Closed = request.security(syminfo.tickerid, "5", time[1], barmerge.gaps_off, barmerge.lookahead_off)
int t1Rb = on1m ? time[1] : t1Closed
int t5Rb = on5m ? time[1] : t5Closed
bool trig1 = barstate.isconfirmed and (on1m or new1Bar)
bool trig5 = barstate.isconfirmed and (on5m or new5Bar)
[b5c, u5c, h5c, l5c, wsB5c, wsU5c] = f_pb1Pack(i_minWick5)
bool b5 = on5m ? b5c : b5s
bool u5 = on5m ? u5c : u5s
float h5 = on5m ? h5c : h5s
float l5 = on5m ? l5c : l5s
float wsB5 = on5m ? wsB5c : wsB5s
float wsU5 = on5m ? wsU5c : wsU5s

// LTF confluence packs (KO scanner — eyes only, never arm)
f_msLtfPack() =>
    bool prevBull = close[1] > open[1]
    bool prevBear = close[1] < open[1]
    bool cisdBear = prevBull and close < open[1]
    bool cisdBull = prevBear and close > open[1]
    bool ifvgBear = low[1] > high[3] and close < high[3]
    bool ifvgBull = high[1] < low[3] and close > low[3]
    float iTop = ifvgBear ? low[1] : ifvgBull ? low[3] : na
    float iBot = ifvgBear ? high[3] : ifvgBull ? high[1] : na
    [cisdBear, cisdBull, ifvgBear, ifvgBull, iTop, iBot]

f_obPack() =>
    bool bearOb = close[1] > open[1] and close < open and close < low[1]
    bool bullOb = close[1] < open[1] and close > open and close > high[1]
    float oTop = high[1]
    float oBot = low[1]
    [bearOb, bullOb, oTop, oBot]

f_fvgPack() =>
    float h3 = high[3]
    float l3 = low[3]
    float h1b = high[1]
    float l1b = low[1]
    bool bull = l1b > h3
    bool bear = h1b < l3
    float top = bull ? l1b : bear ? l3 : na
    float bot = bull ? h3 : bear ? h1b : na
    [bear, bull, top, bot]

[cisd1sB, cisd1sU, ifvg1sB, ifvg1sU, ifvg1sTop, ifvg1sBot] = request.security(syminfo.tickerid, "1", f_msLtfPack(), barmerge.gaps_off, barmerge.lookahead_off)
[ob1sB, ob1sU, ob1sTop, ob1sBot] = request.security(syminfo.tickerid, "1", f_obPack(), barmerge.gaps_off, barmerge.lookahead_off)
[fvg5sB, fvg5sU, fvg5sTop, fvg5sBot] = request.security(syminfo.tickerid, "5", f_fvgPack(), barmerge.gaps_off, barmerge.lookahead_off)
[cisd1cB, cisd1cU, ifvg1cB, ifvg1cU, ifvg1cTop, ifvg1cBot] = f_msLtfPack()
[ob1cB, ob1cU, ob1cTop, ob1cBot] = f_obPack()
[fvg5cB, fvg5cU, fvg5cTop, fvg5cBot] = f_fvgPack()
bool cisd1B = on1m ? cisd1cB : cisd1sB
bool cisd1U = on1m ? cisd1cU : cisd1sU
bool ifvg1B = on1m ? ifvg1cB : ifvg1sB
bool ifvg1U = on1m ? ifvg1cU : ifvg1sU
float ifvg1Top = on1m ? ifvg1cTop : ifvg1sTop
float ifvg1Bot = on1m ? ifvg1cBot : ifvg1sBot
bool ob1B = on1m ? ob1cB : ob1sB
bool ob1U = on1m ? ob1cU : ob1sU
float ob1Top = on1m ? ob1cTop : ob1sTop
float ob1Bot = on1m ? ob1cBot : ob1sBot
bool fvg5B = on5m ? fvg5cB : fvg5sB
bool fvg5U = on5m ? fvg5cU : fvg5sU
float fvg5Top = on5m ? fvg5cTop : fvg5sTop
float fvg5Bot = on5m ? fvg5cBot : fvg5sBot

f_zoneNearKo(float zHi, float zLo, float ko, float pad) =>
    not na(zHi) and not na(zLo) and not na(ko) and zLo - pad <= ko and ko <= zHi + pad

// ─── Plan math ───────────────────────────────────────────────────────────────
// ENTRY is always candle-A body/wick junction (wickStart). Never move entry to CE.
// Wide zone → cap STOP at max pts from entry (keep limit where you place it live).
// Tiny zone → invalidate (na), do not slide entry deeper.
f_plan(float wickStart, float ce, float extreme, bool isShort) =>
    float entryPx = wickStart
    float stopRaw = isShort ? extreme + i_stopBufPts : extreme - i_stopBufPts
    float risk = math.abs(stopRaw - entryPx)
    float stopOut = stopRaw
    if na(entryPx) or na(extreme)
        entryPx := na
        stopOut := na
    else if risk < i_minStopPts
        entryPx := na
        stopOut := na
    else if risk > i_maxStopPts
        stopOut := isShort ? entryPx + i_maxStopPts : entryPx - i_maxStopPts
    [entryPx, stopOut]

// Leave KO proximity: uses leave pad (A/B), not locked pathBAlign (still used for NWOG / return).
f_leaveNearKo(float a, float b) =>
    not na(a) and not na(b) and math.abs(a - b) <= i_leaveKoPad

f_leaveNearKoBand(float hi, float lo, float ko) =>
    not na(hi) and not na(lo) and not na(ko) and lo <= ko + i_leaveKoPad and hi >= ko - i_leaveKoPad

// Loose ±pathBAlign (NWOG grade / return pad — not leave arm gate)
f_nearKo(float a, float b) =>
    not na(a) and not na(b) and math.abs(a - b) <= i_pathBAlign

f_nearKoBand(float hi, float lo, float ko) =>
    not na(hi) and not na(lo) and not na(ko) and lo <= ko + i_pathBAlign and hi >= ko - i_pathBAlign

// Strict: 10:00 open lies inside the RB zone (±powellKoTol). Powell always; leave when gate = KO in RB zone.
f_koInRbZone(float zHi, float zLo, float ko) =>
    not na(zHi) and not na(zLo) and not na(ko) and zLo - i_powellKoTol <= ko and ko <= zHi + i_powellKoTol

// Leave sleeve KO ok — Pad ±N or same zone gate as Powell.
f_leaveKoOk(float ws, float ex, float ko) =>
    float zHi = math.max(ws, ex)
    float zLo = math.min(ws, ex)
    bool zoneOk = f_koInRbZone(zHi, zLo, ko)
    bool padOk = f_leaveNearKo(ws, ko) or f_leaveNearKo(ex, ko) or f_leaveNearKoBand(zHi, zLo, ko)
    i_leaveKoGate == "KO in RB zone" ? zoneOk : padOk

// Fixed 1:5 with hard pt cap + optional min floor (v15 parity uses 80).
f_fixedTp(float entry, float risk, int dir) =>
    float rew5 = i_rr * risk
    float rew = i_minTpPts > 0 ? math.min(i_powellMaxTpPts, math.max(rew5, i_minTpPts)) : math.min(i_powellMaxTpPts, rew5)
    dir == 1 ? entry + rew : entry - rew

// Live FILL→ advice while a plan is pending (discretionary MKT vs LMT).
f_fillAdvice(int dir, float entry) =>
    string adv = "LMT"
    if na(entry) or dir == 0
        adv := "—"
    else
        float dist = dir == 1 ? close - entry : entry - close
        bool through = dir == 1 ? close <= entry : close >= entry
        bool fallingToward = dir == 1 ? close < close[1] : close > close[1]
        bool rippingAway = dir == 1 ? close > close[1] : close < close[1]
        if through
            adv := "MKT"
        else if dist <= i_approachPts and fallingToward
            adv := "LMT·coming"
        else if dist <= i_approachPts
            adv := "LMT·near"
        else if rippingAway
            adv := "AWAY"
        else
            adv := "LMT·wait"
    adv

// Try one structure candidate; keep nearest valid inside [minR, maxR] ≤ maxPts.
f_considerTp(float entry, float stop, int dir, float cand, string tag, float bestRew, float bestTp, string bestTag) =>
    float risk = math.abs(entry - stop)
    float outRew = bestRew
    float outTp = bestTp
    string outTag = bestTag
    if not na(cand)
        float rew = dir == 1 ? cand - entry : entry - cand
        bool sideOk = dir == 1 ? cand > entry : cand < entry
        bool minOk = rew >= risk * i_powellMinTpR
        bool maxOk = rew <= risk * i_powellMaxTpR and rew <= i_powellMaxTpPts
        if sideOk and minOk and maxOk and (na(bestTp) or rew < bestRew)
            outRew := rew
            outTp := cand
            outTag := tag
    [outRew, outTp, outTag]

// Dual47 TP — Fixed R (1:5 · cap 100). Structure kept but locked OFF.
f_powellTp(float entry, float stop, int dir, float intEx, float intBody, float legEx, float legBody, float ko, float dil, float dih, float nwogMid) =>
    float risk = math.abs(entry - stop)
    float fixedTp = f_fixedTp(entry, risk, dir)
    float oCe = not na(intEx) ? (not na(intBody) ? (intEx + intBody) * 0.5 : intEx) : na
    float lCe = not na(legEx) ? (not na(legBody) ? (legEx + legBody) * 0.5 : legEx) : na
    float out = fixedTp
    string outTag = "Rfb"
    if i_powellTp == "Fixed R"
        out := fixedTp
        outTag := "Rfb"
    else if i_powellTp == "Nearest structure (band)"
        [r0, t0, g0] = f_considerTp(entry, stop, dir, oCe, "oCE", 1e9, na, "")
        [r1, t1, g1] = f_considerTp(entry, stop, dir, intEx, "oHI", r0, t0, g0)
        [r2, t2, g2] = f_considerTp(entry, stop, dir, lCe, "lCE", r1, t1, g1)
        [r3, t3, g3] = f_considerTp(entry, stop, dir, legEx, "lHI", r2, t2, g2)
        [r5, t5, g5] = f_considerTp(entry, stop, dir, dir == -1 ? dil : na, "DIL", r3, t3, g3)
        [r6, t6, g6] = f_considerTp(entry, stop, dir, dir == 1 ? dih : na, "DIH", r5, t5, g5)
        [r7, t7, g7] = f_considerTp(entry, stop, dir, nwogMid, "NWOG", r6, t6, g6)
        if not na(t7)
            out := t7
            outTag := g7
        else
            out := fixedTp
            outTag := "Rfb"
    else
        float structTp = na
        string tag = "R"
        if (i_powellTp == "Origin CE" or i_powellTp == "Internal CE") and not na(oCe)
            structTp := oCe
            tag := "oCE"
        else if (i_powellTp == "Origin high" or i_powellTp == "Internal high") and not na(intEx)
            structTp := intEx
            tag := "oHI"
        else if i_powellTp == "Leg CE" and not na(lCe)
            structTp := lCe
            tag := "lCE"
        else if i_powellTp == "Leg high" and not na(legEx)
            structTp := legEx
            tag := "lHI"
        if not na(structTp)
            float rew = dir == 1 ? structTp - entry : entry - structTp
            bool sideOk = dir == 1 ? structTp > entry : structTp < entry
            bool minOk = rew >= risk * i_powellMinTpR
            bool maxOk = rew <= risk * i_powellMaxTpR and rew <= i_powellMaxTpPts
            if sideOk and minOk and maxOk
                out := structTp
                outTag := tag
    [out, outTag]

